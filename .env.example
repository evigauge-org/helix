DATABASE_URL=postgresql://user:password@host:5432/dbname
BETTER_AUTH_SECRET=your-secret-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Gamma AI (get key from gamma.app/settings/api-keys)
GAMMA_API_KEY=

# Store Builder
EXA_API_KEY=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_ACCESS_TOKEN=

# Apify — LinkedIn profile sourcing (harvestapi~linkedin-profile-search actor)
APIFY_TOKEN=apify_api_xxxxxxxxxxxxxxxx
# Optional — ceiling on maxItems per run (default 50 in tool schema)
APIFY_MAX_ITEMS_CAP=50

# Firecrawl — web search + scrape for recruitment cross-reference
FIRECRAWL_API_KEY=fc-xxxxxxxxxxxxxxxx

# PageIndex API key for PDF parsing/retrieval (https://pageindex.ai)
PAGEINDEX_API_KEY=

# E2B — sandboxed Python/JavaScript execution for the run_code agent tool
# Get a key from https://e2b.dev/dashboard. If unset, the run_code tool
# returns a clean config-error result; the app boots fine without it.
E2B_API_KEY=

# SEC EDGAR requires a self-identifying User-Agent per its fair-use policy.
# Format: "<organization> <contact-email>"
SEC_EDGAR_USER_AGENT=Helix ops@helix.ai

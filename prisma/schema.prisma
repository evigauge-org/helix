model AepPendingPromptChange {
  id              String    @id @default(cuid())
  aepId           String    @unique // "pch_..."
  agentId         String
  proposedDiff    String    @db.Text
  proposedContent String    @db.Text // resolved full text after applying the diff
  mode            String // "replace" | "diff"
  reason          String    @db.Text
  createdAt       DateTime  @default(now())
  resolvedAt      DateTime?
  resolution      String? // "approved" | "rejected"
  resolvedBy      String?
  comment         String?   @db.Text

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, createdAt])
  @@index([agentId, resolvedAt])
}

// --- GDPR / Compliance (Plan 6 / Phase 7) -----------------------------------
// `subject_id` (e.g. "sub_…") is tagged on records that may contain PII for a
// natural person. The Subject row itself stores any per-subject metadata and
// the legal-hold flag. SubjectErasureLog records every erase call for audit.
//
// Records that carry subject_ids:
//   Agent.subjectIds (multi)        — strip-from-list when one of many
//   AgentRun.subjectIds (multi)     — strip-from-list when one of many
//   AgentArtifact.subjectId (single) — delete or redact
//   AepMemoryRecord.subjectId (single, indexed) — delete or redact
//   AgentMessage.subjectId (single, added in this plan) — delete or redact

model Subject {
  id        String   @id @default(cuid())
  aepId     String   @unique // "sub_…"
  userId    String
  metadata  Json?
  legalHold Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  erasureLogs SubjectErasureLog[]

  @@index([userId])
  @@map("subject")
}

model SubjectErasureLog {
  id           String   @id @default(cuid())
  // subjectAepId is kept as a string (not FK) so the audit row survives
  // even if the Subject row is later deleted by cascade.
  subjectAepId String
  subjectRowId String?
  userId       String
  mode         String // "hard_delete" | "redact"
  manifest     Json
  performedAt  DateTime @default(now())

  subject Subject? @relation(fields: [subjectRowId], references: [id], onDelete: SetNull)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([subjectAepId, performedAt])
  @@index([userId, performedAt])
  @@map("subject_erasure_log")
}


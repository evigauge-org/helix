# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# env files — never commit real secrets.
# .env.example is the one exception: it is the documented template and
# must stay tracked, so it needs an explicit negation after the wildcard.
.env*.local
.env*
!.env.example

# typescript
*.tsbuildinfo
next-env.d.ts

/generated/prisma
